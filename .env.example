# Bu dosya, `docker compose up` çalıştırıldığında compose.yml'nin okuduğu
# tüm değişkenleri kapsar. `.env` olarak kopyalayıp kendi makinenize göre
# düzenleyin -- `.env` .gitignore'dadır ve commit edilmez.
#
#   cp .env.example .env

# ---- Ollama (yerel LLM) ----
# OLLAMA_BASE_URL burada YOKTUR: Docker Compose backend'i her zaman
# host.docker.internal üzerinden konteyner dışındaki Ollama'ya bağlar
# (compose.yml içinde sabit). Docker olmadan doğrudan çalıştırırken
# kullanılacak değer için backend/.env.example'a bakın.
OLLAMA_MODEL=qwen3.5:9b
# Opsiyonel küçük/hızlı model (niyet çözümleme, yönlendirme, kalite yargıcı
# ve "fast" düşünme seviyesi için). Boş bırakılırsa OLLAMA_MODEL kullanılır.
OLLAMA_FAST_MODEL=
OLLAMA_TEMPERATURE=0.7
# Ollama "thinking mode" -- yapılandırılmış (JSON) çağrılarda her zaman
# kapalıdır, yalnızca serbest metin üretiminde bu bayrağa uyar.
OLLAMA_REASONING=false
OLLAMA_MAX_TOKENS=4096
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=30m
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest

# ---- Sağlayıcı seçimi ----
# true -> yukarıdaki Ollama + yerel Qdrant. false -> Evren (TEKNOFEST'in
# sağladığı barındırılan çıkarım servisi, https://evren-teknofest.ssyz.org.tr)
# + Evren'in kendi Qdrant kümesi. Bkz. app.core.config.Settings.LOCAL_MODE.
LOCAL_MODE=true

# ---- Evren (yalnızca LOCAL_MODE=false iken kullanılır) ----
# Takıma e-posta ile verilen bearer token.
EVREN_API_KEY=
EVREN_BASE_URL=https://evren-llmapi.ssyz.org.tr/v1
EVREN_LLM_LARGE_MODEL=llm-large
EVREN_LLM_FAST_MODEL=llm-fast
EVREN_GUARD_MODEL=guard
EVREN_ROUTER_MODEL=router
EVREN_EMBED_MODEL=bge-m3-embed
EVREN_REQUEST_TIMEOUT_SECONDS=1800
# Evren'in ayrı Qdrant kümesi ve takıma özel Qdrant API anahtarı
# ("qdr-teamNN-..."). Yerel Qdrant'tan tamamen ayrı bir sunucudur -- bkz.
# app.infrastructure.vectorstore.get_vector_store. URL'in sonuna takım yol
# önekini eklemeyi unutmayın (örn. "https://evren-vektor.ssyz.org.tr/team07")
# -- önek olmadan istekler 404/timeout ile başarısız olur.
EVREN_QDRANT_URL=
EVREN_QDRANT_API_KEY=

# ---- AI iş akışı zaman aşımları (saniye) ----
# Yerelde yavaş/CPU'da çalışan bir model ile test ederken "deep" düşünme
# seviyesi bu süreyi aşabilir; testten önce büyütün. AI_WORKFLOW_TIMEOUT_SECONDS
# tek bir grafik çalıştırmasının tavanıdır; sohbet akışı bunu 2x, ardından
# reasoning_level çarpanıyla kullanır (bkz. chat_service.ORCHESTRATION_TIMEOUT_SECONDS).
AI_WORKFLOW_TIMEOUT_SECONDS=480
# Revizyonun koşullu mevzuat yeniden-arama çağrısına tavan.
REVISION_RERETRIEVAL_TIMEOUT_SECONDS=10
# Taslak kalite yargıcının (LLM judge) çağrısına tavan.
DRAFT_JUDGE_TIMEOUT_SECONDS=30
# Guardrail nüans katmanının LLM yargıcına tavan.
GUARDRAIL_JUDGE_TIMEOUT_SECONDS=15
# mevzuat.gov.tr canlı arama çağrısına tavan.
MEVZUAT_MCP_TIMEOUT_SECONDS=25

# ---- PostgreSQL ----
# backend ve langfuse servisleri aynı Postgres örneğini, aynı kullanıcı adı/
# şifre ile paylaşır (langfuse kendi "langfuse" adlı ayrı bir veritabanı
# kullanır, POSTGRES_DB burada yalnızca uygulamanın kendi veritabanıdır).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=kachow

# ---- Langfuse (LLM izleme) ----
# Geliştirme için üretilmiş örnek anahtarlar; kendi Langfuse kurulumunuzdan
# gerçek pk-lf-.../sk-lf-... değerleriyle değiştirin.
LANGFUSE_PUBLIC_KEY=pk-lf-1234567890
LANGFUSE_SECRET_KEY=sk-lf-1234567890
# Yalnızca geliştirme ortamı içindir; üretimde mutlaka değiştirilmelidir.
LANGFUSE_NEXTAUTH_SECRET=my_nextauth_secret_for_dev_only_123
LANGFUSE_SALT=my_salt_for_dev_only_123
LANGFUSE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ---- OpenTelemetry (altyapı izleme: HTTP/DB/Redis/httpx span'leri) ----
# Boş bırakılırsa tracing tamamen devre dışı kalır (no-op degrade,
# app/observability/otel.py). compose.yml'in varsayılanı zaten kendi
# jaeger servisine işaret ediyor -- bu satır yalnızca override etmek
# isteyenler içindir.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317

# ---- Grafana ----
GRAFANA_ADMIN_PASSWORD=admin
