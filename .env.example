# Bu dosya, `docker compose up` çalıştırıldığında compose.yml'nin okuduğu
# tüm değişkenleri kapsar. `.env` olarak kopyalayıp kendi makinenize göre
# düzenleyin -- `.env` .gitignore'dadır ve commit edilmez.
#
#   cp .env.example .env

# ---- Ollama (yerel LLM) ----
# OLLAMA_BASE_URL burada YOKTUR: Docker Compose backend'i her zaman
# host.docker.internal üzerinden konteyner dışındaki Ollama'ya bağlar
# (compose.yml içinde sabit). Docker olmadan doğrudan çalıştırırken
# kullanılacak değer için backend/.env.example'a bakın.
OLLAMA_MODEL=qwen3.5:9b
# Opsiyonel küçük/hızlı model (niyet çözümleme, yönlendirme, kalite yargıcı
# ve "fast" düşünme seviyesi için). Boş bırakılırsa OLLAMA_MODEL kullanılır.
OLLAMA_FAST_MODEL=
OLLAMA_TEMPERATURE=0.7
# Ollama "thinking mode" -- yapılandırılmış (JSON) çağrılarda her zaman
# kapalıdır, yalnızca serbest metin üretiminde bu bayrağa uyar.
OLLAMA_REASONING=false
OLLAMA_MAX_TOKENS=4096
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=30m
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest

# ---- PostgreSQL ----
# backend ve langfuse servisleri aynı Postgres örneğini, aynı kullanıcı adı/
# şifre ile paylaşır (langfuse kendi "langfuse" adlı ayrı bir veritabanı
# kullanır, POSTGRES_DB burada yalnızca uygulamanın kendi veritabanıdır).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=kachow

# ---- Langfuse (LLM izleme) ----
# Geliştirme için üretilmiş örnek anahtarlar; kendi Langfuse kurulumunuzdan
# gerçek pk-lf-.../sk-lf-... değerleriyle değiştirin.
LANGFUSE_PUBLIC_KEY=pk-lf-1234567890
LANGFUSE_SECRET_KEY=sk-lf-1234567890
# Yalnızca geliştirme ortamı içindir; üretimde mutlaka değiştirilmelidir.
LANGFUSE_NEXTAUTH_SECRET=my_nextauth_secret_for_dev_only_123
LANGFUSE_SALT=my_salt_for_dev_only_123
LANGFUSE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ---- Grafana ----
GRAFANA_ADMIN_PASSWORD=admin
