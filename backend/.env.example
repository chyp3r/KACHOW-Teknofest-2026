# Core Settings
PROJECT_NAME=KACHOW-Teknofest-2026
ENVIRONMENT=development

# Database (Optional for now)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kachow

# Ollama Settings
# Use http://localhost:11434 for local host run
# Use http://host.docker.internal:11434 when running backend in Docker on macOS/Windows
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TEMPERATURE=0.7
OLLAMA_REASONING=false
OLLAMA_MAX_TOKENS=1024

# --- Provider selection -------------------------------------------------------
# true -> Ollama above + local Qdrant. false -> Evren (TEKNOFEST-hosted
# inference, https://evren-teknofest.ssyz.org.tr) + Evren's own Qdrant
# cluster. See app.core.config.Settings.LOCAL_MODE.
LOCAL_MODE=true

# --- Evren (only used when LOCAL_MODE=false) ----------------------------------
EVREN_API_KEY=
EVREN_BASE_URL=https://evren-llmapi.ssyz.org.tr/v1
EVREN_LLM_LARGE_MODEL=llm-large
EVREN_LLM_FAST_MODEL=llm-fast
EVREN_GUARD_MODEL=guard
EVREN_ROUTER_MODEL=router
EVREN_EMBED_MODEL=bge-m3-embed
EVREN_REQUEST_TIMEOUT_SECONDS=1800
# Evren's own dedicated Qdrant cluster + team Qdrant API key
# ("qdr-teamNN-..."). A wholly separate server from the local Qdrant -- see
# app.infrastructure.vectorstore.get_vector_store. Append your team's path
# prefix to the URL (e.g. "https://evren-vektor.ssyz.org.tr/team07") --
# without it every request 404s/times out.
EVREN_QDRANT_URL=
EVREN_QDRANT_API_KEY=

# --- AI workflow timeouts (seconds) ------------------------------------------
# Raise these when testing locally against a slow/CPU-only model -- a "deep"
# reasoning run can otherwise time out before it finishes.
AI_WORKFLOW_TIMEOUT_SECONDS=480
REVISION_RERETRIEVAL_TIMEOUT_SECONDS=10
DRAFT_JUDGE_TIMEOUT_SECONDS=30
GUARDRAIL_JUDGE_TIMEOUT_SECONDS=15

# --- Legislation lookup over MCP (github.com/saidsurucu/mevzuat-mcp) ---------
# Two independent switches read the same server -- see core/config.py for the
# full reasoning. Neither is ever a compliance input: check_required_fields is
# set subtraction over a rule table with hard-coded article numbers.
#
# MEVZUAT_SOURCE picks where document analysis's legislation retrieval reads
# from. "mcp" (default) fetches the curated corpus's current official text
# live and falls back to the committed corpus under datasets/mevzuat/ on any
# failure (unreachable server, timeout, empty result). "local" skips MCP
# entirely and always uses the committed corpus.
MEVZUAT_SOURCE=mcp
# MEVZUAT_MCP_ENABLED is the assistant's own switch: adds a
# `search_legislation_live` tool for questions the local corpus tool can't
# answer. Independent of MEVZUAT_SOURCE -- set true to also expose it in chat.
MEVZUAT_MCP_ENABLED=true
#
# Either switch above needs the server actually installed. The Docker image
# (deploy/docker/backend.Dockerfile) already does this at build time, into an
# isolated venv at /tmp/mcpvenv -- compose.yml points MEVZUAT_MCP_COMMAND
# there, so `docker compose up` works with no extra setup. Running the
# backend outside Docker needs the same install done by hand:
#   python -m venv /tmp/mcpvenv
#   /tmp/mcpvenv/bin/pip install "git+https://github.com/saidsurucu/mevzuat-mcp"
#   /tmp/mcpvenv/bin/playwright install --with-deps chromium
#   MEVZUAT_MCP_COMMAND=/tmp/mcpvenv/bin/mevzuat-mcp
# It's a separate venv rather than a dependency added to requirements.txt on
# purpose: its resolved versions of fastapi/pydantic/httpx/mcp land close to
# this project's own pins but not identical (its pydantic-settings resolves
# to 2.15.0 against this project's 2.14.2), which is enough to risk silently
# breaking one side's exact pin in a shared environment.
MEVZUAT_MCP_COMMAND=mevzuat-mcp
# Space-separated argv for the command above. Left blank when the command
# needs no arguments -- true for mevzuat-mcp itself, whose entry point takes
# none; this only matters if MEVZUAT_MCP_COMMAND points at some other server.
MEVZUAT_MCP_ARGS=
MEVZUAT_MCP_TIMEOUT_SECONDS=25
