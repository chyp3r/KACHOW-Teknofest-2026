# Core Settings
PROJECT_NAME=KACHOW-Teknofest-2026
ENVIRONMENT=development

# Database (Optional for now)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kachow

# Ollama Settings
# Use http://localhost:11434 for local host run
# Use http://host.docker.internal:11434 when running backend in Docker on macOS/Windows
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TEMPERATURE=0.7
OLLAMA_REASONING=false
OLLAMA_MAX_TOKENS=1024

# --- Live legislation lookup over MCP (optional, off by default) -------------
# Adds a `search_legislation_live` tool to the assistant, querying mevzuat.gov.tr
# through github.com/saidsurucu/mevzuat-mcp. The committed corpus under
# datasets/mevzuat/ answers every scored requirement with no network, so this is
# an escalation for questions that corpus does not cover -- never a compliance
# input, and never on the document analysis path.
#
# The server is NOT in the backend image (its dependency tree pins playwright and
# pulls a browser binary). Enabling this needs an installed copy:
#   python -m venv /tmp/mcpvenv
#   /tmp/mcpvenv/bin/pip install "git+https://github.com/saidsurucu/mevzuat-mcp"
#   MEVZUAT_MCP_COMMAND=/tmp/mcpvenv/bin/mevzuat-mcp
MEVZUAT_MCP_ENABLED=false
MEVZUAT_MCP_COMMAND=mevzuat-mcp
# Space-separated argv for the command above, e.g. "--transport stdio". Not a
# JSON array -- write it exactly like you would on a shell command line. Left
# blank when the command needs no arguments (the common case).
MEVZUAT_MCP_ARGS=
MEVZUAT_MCP_TIMEOUT_SECONDS=25
