# Consumed by compose.prod.yml, not compose.yml -- run as:
#   cp .env.prod.example .env.prod   # then edit every value below
#   docker compose -f compose.yml -f compose.prod.yml --env-file .env.prod up -d
#
# Unlike .env.example (whose values all have safe dev defaults),
# compose.prod.yml uses Compose's `${VAR:?message}` syntax for every value
# below -- `up` refuses to start at all if any of them is unset, on purpose
# (see compose.prod.yml's own top-of-file comment). This file has no working
# defaults; every line must be replaced with a real value before use.

# ---- Backend ----
# Signs every access/refresh JWT. `openssl rand -hex 32` or equivalent.
# app.lifespan._require_secret_key_in_production additionally refuses to
# boot if this is left at its published source default.
SECRET_KEY=

# Where the backend reaches your Ollama instance. host.docker.internal only
# resolves to the Docker host itself -- for a dedicated Ollama server, use
# its real address instead.
OLLAMA_BASE_URL=

# ---- PostgreSQL ----
# The schema-owner role (migrations, login/refresh identity lookups).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=kachow
# The restricted, RLS-subject runtime role the backend actually connects as
# for everything else -- see compose.yml's own comment on why this must
# never be the owner role above.
KACHOW_APP_DB_PASSWORD=

# ---- Optional (safe defaults already applied in compose.prod.yml) ----
# IMAGE_TAG=latest
# FRONTEND_PORT=80
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=http://langfuse:3000
# MEVZUAT_SOURCE=local
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
